# Obtain your own key(s) at https://fish.audio/app/api-keys
# Multiple keys: comma-separated, or add them after signing in at /admin.
FISH_API_KEYS=
FISH_MODEL=s2.1-pro-free
FISH_VOICE_RU=680d74fbef69419f87cfc70f092a1451
FISH_VOICE_EN=14129c3e320149449d6bada6862f7338
FISH_KEY_CONCURRENCY=2
FISH_LATENCY=balanced
FISH_TIMEOUT_MS=45000

# Set a strong password before using /admin. No default password is supplied.
ADMIN_PASSWORD=
# Set a separate, random secret on Vercel (e.g. node -e "console.log(require('crypto').randomBytes(32).toString('hex'))").
ADMIN_SESSION_SECRET=

PORT=3000
HOST=127.0.0.1
# Standalone state is saved here, including the keys added in /admin.
DATA_FILE=.data/state.json

# Required on Vercel: shared durable state, limits, key leases and cache.
# Upstash REST credentials (KV_REST_API_URL / KV_REST_API_TOKEN are also accepted).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
REDIS_PREFIX=jarvis-tts

# Only set this behind a reverse proxy that overwrites X-Forwarded-For.
TRUST_PROXY=false
