{
  "name": "jarvis-tts-server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "An independently implemented Fish Audio server compatible with the Jarvis desktop client",
  "engines": { "node": ">=22.18.0" },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/server.mjs",
    "dev": "node --watch --env-file-if-exists=.env src/server.mjs",
    "test": "node --test tests/*.test.mjs",
    "check": "node scripts/check.mjs"
  }
}
